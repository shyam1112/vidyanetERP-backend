PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/vidyanet?retryWrites=true&w=majority

# JWT — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_bucket_name

# Frontend URL (Vercel) — comma-separate multiple if needed
# e.g. https://vidyanet.vercel.app,https://yourdomain.com
FRONTEND_URL=https://your-app.vercel.app

# Email (SMTP) — for OTP / forgot password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Vidyanet ERP <your_email@gmail.com>"
